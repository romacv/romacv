{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "readme.md",
      "firebase-debug.log*",
      "firebase-debug.*.log*",
      "**/*.scss",
      "**/*.map",
      "**/.*",
      "**/node_modules/**",
      "autopost/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "autopost/functions",
      "codebase": "autopost",
      "runtime": "python312"
    },
    {
      "source": "autopost/budget",
      "codebase": "budget",
      "runtime": "python312"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "bucket": "resromcom-493b4-autopost",
      "rules": "storage.rules"
    }
  ]
}
