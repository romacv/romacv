{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/contact",
        "destination": "/projects/contact",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "readme.md",
      "firebase-debug.log*",
      "firebase-debug.*.log*",
      "**/*.scss",
      "**/*.map",
      "**/.*",
      "**/node_modules/**",
      "autopost/**",
      "blog-engine/**",
      "blog-posts/**"
    ],
    "predeploy": ["python3 blog-engine/render_all.py --src blog-posts --out ."],
    "postdeploy": ["python3 blog-engine/after_deploy.py"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/files/scroller-camera.zip",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "autopost/functions",
      "codebase": "autopost",
      "runtime": "python312",
      "ignore": ["venv", "__pycache__", "tests", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    },
    {
      "source": "autopost/budget",
      "codebase": "budget",
      "runtime": "python312",
      "ignore": ["venv", "__pycache__", "tests", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "bucket": "resromcom-493b4-autopost",
      "rules": "storage.rules"
    }
  ]
}
