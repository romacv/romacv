{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/contact",
        "destination": "/projects/contact",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "readme.md",
      "firebase-debug.log*",
      "firebase-debug.*.log*",
      "**/*.scss",
      "**/*.map",
      "**/.*",
      "**/node_modules/**",
      "blog-engine/**",
      "gha-creds-*.json"
    ],
    "predeploy": ["blog-engine/venv/bin/python blog-engine/render_all.py --out ."],
    "postdeploy": ["blog-engine/venv/bin/python blog-engine/after_deploy.py"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/files/scroller-camera.zip",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
